{
  "name": "strangetheory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/migrate.ts && tsx server/seed-cli.ts && tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "STRANGETHEORY_NO_LISTEN=1 tsx --test src/lib/logic.test.ts server/db.test.ts server/api.test.ts",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed-cli.ts",
    "smoke": "tsx server/smoke.ts",
    "seed:clear": "tsx server/purge-seed.ts",
    "admin:create": "tsx server/create-admin.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sentry/node": "^11.13.0",
    "@sentry/react": "^11.13.0",
